# Next.js local persistent SQLite database (optional override).
DATABASE_PATH=./data/meemaw.sqlite
# Required if a reverse proxy changes the request origin. Include scheme and port.
APP_ORIGIN=http://localhost:3000

# Friend's backend. These are the adapter's proposed defaults, not a verified contract.
# e.g. http://localhost:8000 — private/local URLs work from the Next.js server.
FRIEND_API_BASE_URL=
FRIEND_ACTIVITY_PATH=activity
FRIEND_ASK_PATH=ask
FRIEND_API_KEY=

# Optional agent service boundary. The CrewAI worker should run outside Daytona
# and return normalized JSON to the Next.js backend.
CREWAI_API_BASE_URL=
CREWAI_API_KEY=

# Optional direct You.com credentials for the agent worker. Prefer routing
# through One or You.com's MCP server when the worker is configured that way.
YOU_SEARCH_API_KEY=
YOU_RESEARCH_API_KEY=
YOU_FINANCE_API_KEY=

# Optional Daytona credentials for the repair worker. Keep these server-only.
DAYTONA_API_KEY=

# One Connect OAuth app (Confidential). All values are server-only.
ONE_CLIENT_ID=
ONE_CLIENT_SECRET=
ONE_REDIRECT_URI=
ONE_PERMISSION_SET=
# Generate a stable random 32-byte key, hex encoded. Keep it across restarts.
ONE_TOKEN_ENCRYPTION_KEY=

# Existing hackathon provider keys. Not used as substitutes for app OAuth credentials.
DAYTONA=
YOUCOM=
