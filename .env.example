# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only: add this in Vercel Project > Settings > Environment Variables.
# Never prefix private keys with VITE_.
YDC_API_KEY=replace_with_you_com_api_key

# Optional. Used only if you later add a model provider or Vercel AI Gateway.
# OPENAI_API_KEY=
# VERCEL_OIDC_TOKEN=
